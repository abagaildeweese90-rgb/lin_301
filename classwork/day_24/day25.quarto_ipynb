{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: \"day25\"\n",
        "format:\n",
        "  html:\n",
        "    code-fold: true\n",
        "jupyter: python3\n",
        "---"
      ],
      "id": "f0a10f9d"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import re\n",
        "import pandas as pd\n",
        "\n",
        "# Stopwords (from Day 18)\n",
        "stopwords = [\"the\", \"to\", \"and\", \"of\", \"a\", \"her\", \"i\", \"in\", \"was\", \"it\",\n",
        "             \"she\", \"he\", \"be\", \"that\", \"you\", \"not\", \"had\", \"as\", \"his\", \"for\",\n",
        "             \"with\", \"is\", \"have\", \"but\", \"at\", \"so\", \"all\", \"my\", \"been\", \"him\",\n",
        "             \"on\", \"by\", \"could\", \"would\", \"very\", \"no\", \"what\", \"which\", \"they\",\n",
        "             \"were\", \"there\", \"me\", \"an\", \"must\", \"this\", \"said\", \"from\", \"or\",\n",
        "             \"will\", \"any\", \"much\", \"than\", \"such\", \"their\", \"them\", \"if\", \"do\",\n",
        "             \"did\", \"one\", \"when\", \"your\", \"more\", \"are\", \"we\", \"who\", \"up\",\n",
        "             \"out\", \"down\", \"into\", \"s\", \"t\"]\n",
        "\n",
        "# 1. Load Alice and cut off the Gutenberg header and footer\n",
        "with open(\"../../data/gutenberg/alice.txt\", \"r\", encoding=\"utf-8\") as f:\n",
        "    alice_lines = f.readlines()\n",
        "\n",
        "while not alice_lines[0].startswith(\"*** START\"):\n",
        "    alice_lines = alice_lines[1:]\n",
        "alice_lines = alice_lines[1:]\n",
        "\n",
        "while not alice_lines[-1].startswith(\"*** END\"):\n",
        "    alice_lines = alice_lines[:-1]\n",
        "alice_lines = alice_lines[:-1]\n",
        "\n",
        "alice_text = \"\".join(alice_lines)\n",
        "\n",
        "# 2. Split into chapters (and drop everything before Chapter I)\n",
        "chapters = re.split(r\"\\nCHAPTER [IVXL]+\", alice_text)\n",
        "chapters = chapters[1:]\n",
        "\n",
        "# 3. One row per word, with its chapter\n",
        "rows = []\n",
        "chapter_num = 0\n",
        "\n",
        "for chapter in chapters:\n",
        "    chapter_num += 1\n",
        "    words = re.split(r\"[\\W_]+\", chapter.lower())   # split on \\W AND on _\n",
        "    words = [w for w in words if w != \"\"]\n",
        "    for w in words:\n",
        "        rows.append({\"word\": w, \"chapter\": chapter_num})\n",
        "\n",
        "alice_df = pd.DataFrame(rows)\n",
        "\n",
        "# 4. Save it for next time\n",
        "alice_df.to_csv(\"alice_words.csv\", index=False, encoding=\"utf-8-sig\")"
      ],
      "id": "855649a5",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "print(len(alice_df))\n",
        "print(alice_df[\"chapter\"].nunique())\n",
        "print(alice_df.head())"
      ],
      "id": "f56cfcc3",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "alice_df[\"word\"].value_counts()\n",
        "content = alice_df[~alice_df[\"word\"].isin(stopwords)]\n",
        "print(content[\"word\"].value_counts().head(10))"
      ],
      "id": "2fbf691e",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "alice_df[\"chapter\"].value_counts()\n",
        "alice_df[\"chapter\"].value_counts().sort_index()"
      ],
      "id": "91ceba60",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "ch1_content = alice_df[(alice_df[\"chapter\"] == 1) & (~alice_df[\"word\"].isin(stopwords))]\n",
        "print(ch1_content[\"word\"].value_counts().head(5))"
      ],
      "id": "c4f6fea0",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "queen = alice_df[alice_df[\"word\"] == \"queen\"]\n",
        "queen[\"chapter\"].value_counts().sort_index()"
      ],
      "id": "fdf1f153",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# She first appears in chapter 8 of the story and then most likely takes over in chapter 9 because of how frequently the book refers to her in both of these chapters"
      ],
      "id": "1933e3c6"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "cat = alice_df[alice_df[\"word\"] == \"cat\"]\n",
        "print(cat[\"chapter\"].value_counts().sort_index())\n",
        "hatter = alice_df[alice_df[\"word\"] == \"hatter\"]\n",
        "print(hatter[\"chapter\"].value_counts().sort_index())\n",
        "ly = alice_df[alice_df[\"word\"].str.endswith(\"ing\")]\n",
        "print(ly[\"chapter\"].value_counts().sort_index())"
      ],
      "id": "f3d1d8dc",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "#1. Chapters 1, 2, 3, 6, 8\n",
        "#2. Chapters 6, 7, 11\n",
        "#3. 1: 67, 2:66 , 3: 60, 4: 96, 5: 64, 6: 90, 7: 83, 8: 101, 9: 63, 10: 60, 11: 68, 12: 101"
      ],
      "id": "34a20601"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "queen_by_chapter = {}\n",
        "\n",
        "for w, ch in zip(alice_df[\"word\"], alice_df[\"chapter\"]):\n",
        "    if w == \"queen\":\n",
        "        if ch in queen_by_chapter:\n",
        "            queen_by_chapter[ch] += 1\n",
        "        else:\n",
        "            queen_by_chapter[ch] = 1\n",
        "\n",
        "print(queen_by_chapter)"
      ],
      "id": "8ed98b0c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "alice_df[alice_df[\"word\"] == \"queen\"][\"chapter\"].value_counts().sort_index()"
      ],
      "id": "a25b03f4",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "#Adds a column (length)"
