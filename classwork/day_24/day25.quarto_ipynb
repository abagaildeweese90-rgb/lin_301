      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "#Adds true or false column"
      ],
      "id": "8f40d911"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "alice_df[\"is_ly\"] = alice_df[\"word\"].str.endswith(\"ly\")\n",
        "alice_df[\"is_stopword\"] = alice_df[\"word\"].isin(stopwords)\n",
        "alice_df.head(10)"
      ],
      "id": "8f59dc1d",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "#Adds the same value to each row "
      ],
      "id": "875a88fb"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "alice_df[\"text\"] = \"alice\"\n",
        "alice_df.head()"
      ],
      "id": "8553697e",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "#type/token ratio"
      ],
      "id": "8e73c093"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "tokens = len(alice_df)\n",
        "types = alice_df[\"word\"].nunique()     # number of unique words\n",
        "\n",
        "print(tokens, types, types / tokens)"
      ],
      "id": "ac70f8e5",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "#.sort_values() sorts by column and .drop_duplicates() gets rid of duplicates"
      ],
      "id": "7b1b3881"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "alice_types = alice_df.drop_duplicates(\"word\")\n",
        "alice_types.sort_values(\"length\", ascending=False).head(10)"
      ],
      "id": "1db3c1e4",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import re\n",
        "import pandas as pd\n",
        "\n",
        "# Stopwords (from Day 18)\n",
        "stopwords = [\"the\", \"to\", \"and\", \"of\", \"a\", \"her\", \"i\", \"in\", \"was\", \"it\",\n",
        "             \"she\", \"he\", \"be\", \"that\", \"you\", \"not\", \"had\", \"as\", \"his\", \"for\",\n",
        "             \"with\", \"is\", \"have\", \"but\", \"at\", \"so\", \"all\", \"my\", \"been\", \"him\",\n",
        "             \"on\", \"by\", \"could\", \"would\", \"very\", \"no\", \"what\", \"which\", \"they\",\n",
        "             \"were\", \"there\", \"me\", \"an\", \"must\", \"this\", \"said\", \"from\", \"or\",\n",
        "             \"will\", \"any\", \"much\", \"than\", \"such\", \"their\", \"them\", \"if\", \"do\",\n",
        "             \"did\", \"one\", \"when\", \"your\", \"more\", \"are\", \"we\", \"who\", \"up\",\n",
        "             \"out\", \"down\", \"into\", \"s\", \"t\"]\n",
        "\n",
        "# 1. Load Alice and cut off the Gutenberg header and footer\n",
        "with open(\"../../data/gutenberg/mansfield_park.txt\", \"r\", encoding=\"utf-8\") as f:\n",
        "    mfp_lines = f.readlines()\n",
        "\n",
        "while not mfp_lines[0].startswith(\"*** START\"):\n",
        "    mfp_lines = alice_lines[1:]\n",
        "mfp_lines = mfp_lines[1:]\n",
        "\n",
        "while not mfp_lines[-1].startswith(\"*** END\"):\n",
        "    mfp_lines = mfp_lines[:-1]\n",
        "mfp_lines = mfp_lines[:-1]\n",
        "\n",
        "mfp_text = \"\".join(mfp_lines)\n",
        "\n",
        "# 2. Split into chapters (and drop everything before Chapter I)\n",
        "chapters = re.split(r\"\\nCHAPTER [IVXL]+\", mfp_text)\n",
        "chapters = chapters[1:]\n",
        "\n",
        "# 3. One row per word, with its chapter\n",
        "rows = []\n",
        "chapter_num = 0\n",
        "\n",
        "for chapter in chapters:\n",
        "    chapter_num += 1\n",
        "    words = re.split(r\"[\\W_]+\", chapter.lower())   # split on \\W AND on _\n",
        "    words = [w for w in words if w != \"\"]\n",
        "    for w in words:\n",
        "        rows.append({\"word\": w, \"chapter\": chapter_num})\n",
        "\n",
        "mfp_df = pd.DataFrame(rows)\n",
        "\n",
        "# 4. Save it for next time\n",
        "mfp_df.to_csv(\"mfp_words.csv\", index=False, encoding=\"utf-8-sig\")"
      ],
      "id": "e64d2c3a",
      "execution_count": null,
      "outputs": []
    }
