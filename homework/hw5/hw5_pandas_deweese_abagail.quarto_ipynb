      "source": [
        "---\n",
        "title: \"hw5_deweese_abagail\"\n",
        "format:\n",
        "  html:\n",
        "    code-fold: true\n",
        "jupyter: python3\n",
        "---\n"
      ],
      "id": "f96fe6fa"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import re\n",
        "import pandas as pd"
      ],
      "id": "7ad84264",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Stopwords (from Day 18)\n",
        "stopwords = [\"the\", \"to\", \"and\", \"of\", \"a\", \"her\", \"i\", \"in\", \"was\", \"it\",\n",
        "             \"she\", \"he\", \"be\", \"that\", \"you\", \"not\", \"had\", \"as\", \"his\", \"for\",\n",
        "             \"with\", \"is\", \"have\", \"but\", \"at\", \"so\", \"all\", \"my\", \"been\", \"him\",\n",
        "             \"on\", \"by\", \"could\", \"would\", \"very\", \"no\", \"what\", \"which\", \"they\",\n",
        "             \"were\", \"there\", \"me\", \"an\", \"must\", \"this\", \"said\", \"from\", \"or\",\n",
        "             \"will\", \"any\", \"much\", \"than\", \"such\", \"their\", \"them\", \"if\", \"do\",\n",
        "             \"did\", \"one\", \"when\", \"your\", \"more\", \"are\", \"we\", \"who\", \"up\",\n",
        "             \"out\", \"down\", \"into\", \"s\", \"t\"]"
      ],
      "id": "4b46339b",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "with open(\"../../homework/hw5/hw5_raw.txt\", \"r\", encoding=\"utf-8\") as f:\n",
        "    fin_lines = f.readlines()\n",
        "clean_text = \"\".join(fin_lines)"
      ],
      "id": "271175c5",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "songs = re.split(r\"\\*[^*]*\\*\", fin_text)\n",
        "songs = songs[1:]"
      ],
      "id": "3f1ba003",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "verses = re.split(r'\\[.*?\\]', clean_text)"
      ],
      "id": "ca29157d",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "rows = []\n",
        "songs_num = 0\n",
        "\n",
        "for song in songs:\n",
        "    songs_num += 1\n",
        "    verses_num = 0\n",
        "    for verse in verses:\n",
        "        verses_num += 1\n",
        "    lines = re.split(r\"[\\n]+\", song.lower()) \n",
        "    lines = [l for l in lines if l != \"\"]\n",
        "    for l in lines:\n",
        "        rows.append({\"line\": l, \"songs\": songs_num, \"verses\": verses_num})\n",
        "\n",
        "fin_df = pd.DataFrame(rows)"
      ],
      "id": "7b7e561c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "fin_df['length'] = fin_df['line'].str.split().str.len()\n",
        "fin_df['has_love'] = fin_df['line'].str.contains('love').astype(bool)"
      ],
      "id": "173f5870",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# 4. Save it for next time\n",
        "fin_df.to_csv(\"hw5_deweese_abagail.csv\", index=False, encoding=\"utf-8-sig\")\n",
        "check = pd.read_csv(\"hw5_deweese_abagail.csv\")\n",
        "print(len(fin_df), len(check))\n",
        "check.head(10)"
      ],
      "id": "2e417313",
      "execution_count": null,
      "outputs": []
    }
  ],
