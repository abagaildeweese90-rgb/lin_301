      "source": [
        "with open(\"../../homework/hw5/hw5_raw.txt\", \"r\", encoding=\"utf-8\") as f:\n",
        "    fin_lines = f.readlines()\n",
        "\n",
        "while not fin_lines[0].startswith(\"*** START\"):\n",
        "    fin_lines = fin_lines[1:]\n",
        "fin_lines = fin_lines[1:]\n",
        "\n",
        "while not fin_lines[-1].startswith(\"*** END\"):\n",
        "    fin_lines = fin_lines[:-1]\n",
        "fin_lines = fin_lines[:-1]\n",
        "\n",
        "fin_text = \"\".join(fin_lines)\n",
        "\n",
        "print(fin_lines)\n",
        "print(fin_text)"
      ],
      "id": "9dd11408",
      "execution_count": null,
      "outputs": []
    },
