        "    fin_text = \"\".join(fin_lines)\n",
        "    clean_text = re.sub(r'\\[.*?\\]', '', fin_text)\n",
        "    lines = re.split(r\"[\\n]+\", song.lower()) \n",
        "    lines = [l for l in lines if l != \"\"]\n",
        "    for l in lines:\n",
        "        rows.append({\"line\": l, \"songs\": songs_num})\n",
        "\n",
        "fin_df = pd.DataFrame(rows)"
