    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def normalize(text):\n",
        "    return unicodedata.normalize(\"NFC\", text).casefold()\n",
        "\n",
        "# Search terms for the famous line.\n",
        "# Adjust these if the wording in your Gutenberg editions differs.\n",
        "anchors = {\n",
        "    \"English\": [\"fair is foul\", \"foul is fair\"],\n",
        "    \"Finnish\": [\"kaunis on rumaa\", \"ruma kaunista\"],\n",
        "    \"Greek\": [\"το ωραίο είναι άσχημο\", \"το άσχημο ωραίο\"]\n",
        "}\n",
        "\n",
        "def find_passage(text, language):\n",
        "    normalized_text = normalize(text)\n",
        "\n",
        "    for phrase in anchors[language]:\n",
        "        phrase = normalize(phrase)\n",
        "        position = normalized_text.find(phrase)\n",
        "\n",
        "        if position != -1:\n",
        "            # Find the sentence containing the match\n",
        "            start = max(\n",
        "                normalized_text.rfind(\".\", 0, position),\n",
        "                normalized_text.rfind(\"!\", 0, position),\n",
        "                normalized_text.rfind(\";\", 0, position)\n",
        "            ) + 1\n",
        "\n",
        "            endings = [\n",
        "                normalized_text.find(mark, position)\n",
        "                for mark in [\".\", \"!\", \"?\", \";\"]\n",
        "            ]\n",
        "            endings = [x for x in endings if x != -1]\n",
        "\n",
        "            end = min(endings) + 1 if endings else len(text)\n",
        "\n",
        "            # Use the same character positions because NFC preserves\n",
        "            # the character sequence for these source strings.\n",
        "            return text[start:end].strip()\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "# Extract and annotate the passage in all three languages\n",
        "passages = {}\n",
        "\n",
        "for language, text in texts.items():\n",
        "    passage = find_passage(text, language)\n",
        "\n",
        "    if passage is None:\n",
        "        print(f\"\\nCould not find the passage in {language}.\")\n",
        "        print(\"Check the translation and update its search anchors.\")\n",
        "        continue\n",
        "\n",
        "    passages[language] = passage\n",
        "\n",
        "    doc = models[language](passage)\n",
        "\n",
        "    rows = []\n",
        "\n",
        "    for token in doc:\n",
        "        if token.is_alpha:\n",
        "            rows.append({\n",
        "                \"Text\": token.text,\n",
        "                \"Lemma\": token.lemma_,\n",
        "                \"POS\": token.pos_,\n",
        "                \"Morphology\": str(token.morph)\n",
        "            })\n",
        "\n",
        "    print(f\"\\n{'=' * 60}\")\n",
        "    print(language)\n",
        "    print(\"Original passage:\", passage)\n",
        "    print(pd.DataFrame(rows).to_string(index=False))"
      ],
      "id": "6dc37423",
      "execution_count": null,
      "outputs": []
    }
